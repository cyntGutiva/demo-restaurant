---
import { supabase } from "../lib/supabase";
import Layout from "../layouts/Layout.astro";

type InfoTienda = {
  whatsapp: string;
  costo_delivery: string;
  pedido_minimo: string;
  tiempo_entrega: string;
  mensaje_whatsapp: string;
  nombre: string;
  direccion: string;
  telefono: string;
  comuna?: string;
  [key: string]: string | undefined;
};

const { data: infoData } = await supabase.from("info_tienda").select("*");

const info = (infoData || []).reduce((acc, item) => {
  acc[item.clave] = item.valor;
  return acc;
}, {} as InfoTienda);

const whatsappLink = `https://wa.me/${info.whatsapp}`;
const costoDelivery = Number(info.costo_delivery || 0);
const pedidoMinimo = Number(info.pedido_minimo || 0);
const tiempoEntrega = info.tiempo_entrega || "30-45 minutos";
const mensajeWhatsapp =
  info.mensaje_whatsapp || "¡Hola! Quiero hacer un pedido:";
---

<Layout title="Finalizar Pedido | Angus Chicken" showCart={false}>
  <main class="py-20 bg-black text-white px-4">
    <div class="max-w-2xl mx-auto">
      <h1 class="text-3xl font-bold mb-8 font-heading text-center">
        Resumen de tu <span class="text-angus-red">Pedido</span>
      </h1>

      <div
        id="cart-summary"
        class="bg-zinc-900/50 rounded-2xl border border-white/5 p-6 mb-10 space-y-4"
      >
      </div>

      <form
        id="order-form"
        class="space-y-6 bg-zinc-900 p-8 rounded-2xl border border-white/5 shadow-2xl"
      >
        <h3 class="text-xl font-bold mb-4 border-b border-white/10 pb-2">
          Datos de Entrega
        </h3>

        <div>
          <label class="block text-sm text-gray-400 mb-2">Nombre Completo</label
          >
          <input
            type="text"
            id="nombre-cliente"
            required
            class="w-full bg-black border border-white/10 p-3 rounded-lg focus:border-angus-red outline-none transition-colors"
          />
          <span id="error-nombre" class="text-angus-red text-xs mt-1 hidden"
          ></span>
        </div>

        <div>
          <label class="block text-sm text-gray-400 mb-2"
            >Teléfono de Contacto</label
          >
          <div
            class="flex items-center bg-black border border-white/10 rounded-lg focus-within:border-angus-red transition-colors overflow-hidden h-[52px]"
          >
            <span
              class="bg-white/5 h-full flex items-center px-4 text-gray-400 border-r border-white/10 text-sm font-medium whitespace-nowrap flex-shrink-0"
            >
              +56 9
            </span>
            <input
              type="tel"
              id="telefono-cliente"
              placeholder="1234 5678"
              maxlength="8"
              required
              class="w-full bg-transparent px-4 text-white outline-none font-medium placeholder:text-zinc-600"
            />
          </div>
          <span id="error-telefono" class="text-angus-red text-xs mt-1 hidden"
          ></span>
        </div>

        <h3 class="text-xl font-bold mb-4 border-b border-white/10 pb-2">
          Método de Entrega
        </h3>

        <div class="grid grid-cols-2 gap-4 mb-6">
          <label class="cursor-pointer">
            <input
              type="radio"
              name="tipo-entrega"
              value="delivery"
              checked
              class="peer hidden"
            />
            <div
              class="p-3 text-center rounded-lg border border-white/10 bg-black peer-checked:border-angus-red peer-checked:bg-angus-red/10 transition-all"
            >
              <span class="block text-sm font-bold text-white">Delivery</span>
            </div>
          </label>

          <label class="cursor-pointer">
            <input
              type="radio"
              name="tipo-entrega"
              value="retiro"
              class="peer hidden"
            />
            <div
              class="p-3 text-center rounded-lg border border-white/10 bg-black peer-checked:border-angus-red peer-checked:bg-angus-red/10 transition-all"
            >
              <span class="block text-sm font-bold text-white"
                >Retiro en Local</span
              >
            </div>
          </label>
        </div>

        <div id="wrapper-direccion" class="space-y-6">
          <div>
            <label class="block text-sm text-gray-400 mb-2"
              >Dirección de Entrega</label
            >
            <textarea
              id="direccion-cliente"
              rows="3"
              class="w-full bg-black border border-white/10 p-3 rounded-lg focus:border-angus-red outline-none transition-colors"
              placeholder="Calle, número, departamento o referencia..."
            ></textarea>
            <span
              id="error-direccion"
              class="text-angus-red text-xs mt-1 hidden"></span>
          </div>
        </div>

        <div
          id="info-local"
          class="hidden p-4 rounded-xl bg-white/5 border border-dashed border-white/20"
        >
          <p class="text-xs text-gray-400 uppercase tracking-widest mb-1">
            Retiras en:
          </p>
          <p class="text-white font-medium">
            {info.direccion}{info.comuna ? `, ${info.comuna}` : ""}
          </p>
        </div>

        <button
          type="submit"
          class="w-full py-4 bg-angus-red hover:bg-red-700 text-white font-bold rounded-xl transition-all shadow-lg shadow-red-900/40 uppercase tracking-wider"
        >
          Enviar pedido por WhatsApp
        </button>

        <a
          href="/"
          class="block text-center text-sm text-gray-500 hover:text-white transition-colors"
        >
          ← Volver a la carta para agregar más
        </a>
      </form>
    </div>
  </main>
</Layout>

<script
  define:vars={{
    costoDelivery,
    pedidoMinimo,
    tiempoEntrega,
    mensajeWhatsapp,
    whatsappLink,
  }}
>
  // --- 1. CONFIGURACIÓN Y SELECTORES ---
  const cart = JSON.parse(localStorage.getItem("cart") || "[]");
  const form = document.getElementById("order-form");
  const summaryDiv = document.getElementById("cart-summary");

  const nodes = {
    nombre: document.getElementById("nombre-cliente"),
    telefono: document.getElementById("telefono-cliente"),
    direccion: document.getElementById("direccion-cliente"),
    wrapperDir: document.getElementById("wrapper-direccion"),
    infoLocal: document.getElementById("info-local"),
    errNombre: document.getElementById("error-nombre"),
    errTelefono: document.getElementById("error-telefono"),
    errDireccion: document.getElementById("error-direccion"),
  };

  let subtotalPedido = 0;

  // --- 2. RENDERIZADO ---
  function render() {
    if (!summaryDiv) return;
    if (cart.length === 0) {
      summaryDiv.innerHTML = `<p class="text-center py-10 text-gray-500">Carrito vacío</p>`;
      form?.classList.add("opacity-50", "pointer-events-none");
      return;
    }

    subtotalPedido = cart.reduce(
      (acc, item) => acc + Number(item.price) * item.qty,
      0,
    );

    let html = cart
      .map(
        (item) => `
      <div class="flex justify-between items-center border-b border-white/5 pb-4">
        <div class="flex flex-col">
          <div class="flex items-center gap-2">
            <span class="text-angus-red font-black text-xl italic">${item.qty}x</span>
            <span class="text-white font-bold text-lg">${item.name}</span>
          </div>
          <span class="text-gray-500 text-xs">$${Number(item.price).toLocaleString("es-CL")} c/u</span>
        </div>
        <span class="font-bold text-angus-orange">$${(item.price * item.qty).toLocaleString("es-CL")}</span>
      </div>
    `,
      )
      .join("");

    // Delivery Visual
    if (costoDelivery > 0) {
      html += `
        <div class="flex justify-between text-gray-400 text-sm py-2">
          <span>Delivery</span><span>$${costoDelivery.toLocaleString("es-CL")}</span>
        </div>`;
    }

    html += `<div class="text-gray-500 text-xs text-right mt-2">⏱ Entrega estimada: ${tiempoEntrega}</div>`;

    // Total Visual
    const totalMostrado = subtotalPedido + costoDelivery;
    html += `
      <div class="pt-4 mt-2 border-t-2 border-white/10 flex justify-between items-center text-xl font-bold">
        <span>Total a Pagar</span>
        <span class="text-angus-red font-black">$${totalMostrado.toLocaleString("es-CL")}</span>
      </div>`;

    summaryDiv.innerHTML = html;

    // Validación Pedido Mínimo
    if (pedidoMinimo > 0 && subtotalPedido < pedidoMinimo) {
      summaryDiv.innerHTML += `<p class="text-yellow-400 text-sm mt-2">⚠️ Pedido mínimo: $${pedidoMinimo.toLocaleString("es-CL")}</p>`;
      form?.classList.add("opacity-50", "pointer-events-none");
    }
  }

  // --- 3. EVENTOS ---

  // Limpiar fono
  nodes.telefono?.addEventListener("input", (e) => {
    e.target.value = e.target.value.replace(/\D/g, "");
  });

  // Toggle Delivery/Retiro
  document.querySelectorAll('input[name="tipo-entrega"]').forEach((radio) => {
    radio.addEventListener("change", (e) => {
      const isRetiro = e.target.value === "retiro";
      nodes.wrapperDir?.classList.toggle("hidden", isRetiro);
      nodes.infoLocal?.classList.toggle("hidden", !isRetiro);
      // Limpiar errores de dirección al cambiar
      nodes.errDireccion?.classList.add("hidden");
      nodes.direccion?.classList.remove("border-angus-red");
    });
  });

  // Envío Formulario
  form?.addEventListener("submit", (e) => {
    e.preventDefault();

    const tipoEntrega = document.querySelector(
      'input[name="tipo-entrega"]:checked',
    ).value;
    const fonoLimpio = nodes.telefono.value.replace(/\s+/g, "");
    const fonoRegex = /^\d{8}$/;
    let esValido = true;

    // Reset Errores
    [nodes.errNombre, nodes.errTelefono, nodes.errDireccion].forEach((el) =>
      el?.classList.add("hidden"),
    );
    [nodes.nombre, nodes.telefono, nodes.direccion].forEach((el) =>
      el?.classList.remove("border-angus-red"),
    );

    // Validar Nombre
    if (nodes.nombre.value.trim() === "") {
      nodes.errNombre.innerText = "El nombre es obligatorio";
      nodes.errNombre.classList.remove("hidden");
      nodes.nombre.classList.add("border-angus-red");
      esValido = false;
    }

    // Validar Teléfono
    if (fonoLimpio.length !== 8 || !fonoRegex.test(fonoLimpio)) {
      nodes.errTelefono.innerText = "Ingresa 8 dígitos válidos";
      nodes.errTelefono.classList.remove("hidden");
      nodes.telefono.closest(".flex")?.classList.add("border-angus-red");
      esValido = false;
    }

    // Validar Dirección CONDICIONAL
    let direccionFinal = "Retiro en local";
    if (tipoEntrega === "delivery") {
      if (nodes.direccion.value.trim() === "") {
        nodes.errDireccion.innerText =
          "La dirección es obligatoria para el despacho";
        nodes.errDireccion.classList.remove("hidden");
        nodes.direccion.classList.add("border-angus-red");
        esValido = false;
      } else {
        direccionFinal = nodes.direccion.value;
      }
    }

    if (!esValido) return;

    // --- 4. CONSTRUCCIÓN WHATSAPP ---
    const totalFinal =
      tipoEntrega === "delivery"
        ? subtotalPedido + costoDelivery
        : subtotalPedido;
    const listaWsp = cart
      .map(
        (item) =>
          `• ${item.qty}x ${item.name} ($${(item.price * item.qty).toLocaleString("es-CL")})`,
      )
      .join("%0A");

    const mensaje =
      `*${mensajeWhatsapp}*%0A%0A` +
      `*Tipo:* ${tipoEntrega.toUpperCase()}%0A` +
      `*Cliente:* ${nodes.nombre.value}%0A` +
      `*Teléfono:* +569${fonoLimpio}%0A` +
      `*Dirección:* ${direccionFinal}%0A%0A` +
      `*Pedido:*%0A${listaWsp}%0A` +
      (tipoEntrega === "delivery" && costoDelivery > 0
        ? `%0A*Envío:* $${costoDelivery.toLocaleString("es-CL")}`
        : "") +
      `%0A*TOTAL: $${totalFinal.toLocaleString("es-CL")}*`;

    window.open(`${whatsappLink}?text=${mensaje}`, "_blank");
  });

  render();
</script>
