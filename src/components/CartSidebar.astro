<button
  id="open-cart"
  class="fixed bottom-8 right-8 z-50 bg-angus-red text-white p-4 rounded-full shadow-2xl hover:scale-110 transition-transform"
>
  <span
    id="cart-count"
    class="absolute -top-2 -right-2 bg-white text-angus-red text-xs font-bold px-2 py-1 rounded-full"
    >0</span
  >
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    ><circle cx="8" cy="21" r="1"></circle><circle cx="19" cy="21" r="1"
    ></circle><path
      d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"
    ></path></svg
  >
</button>

<div
  id="cart-overlay"
  class="fixed inset-0 bg-black/60 z-[60] hidden backdrop-blur-sm"
>
</div>

<aside
  id="cart-sidebar"
  class="fixed top-0 right-0 h-full w-full max-w-md bg-angus-black z-[70] shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out border-l border-white/10"
>
  <div class="p-6 h-full flex flex-col">
    <div class="flex justify-between items-center mb-8">
      <h2 class="text-2xl font-bold text-white font-heading">
        Tu <span class="text-angus-red">Pedido</span>
      </h2>
      <button id="close-cart" class="text-gray-400 hover:text-white">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg
        >
      </button>
    </div>

    <div id="sidebar-cart-items" class="flex-1 overflow-y-auto space-y-4">
      <p class="text-gray-500 text-center mt-10">Tu carrito está vacío</p>
    </div>

    <div class="border-t border-white/10 pt-6 mt-6">
      <div class="flex justify-between text-xl font-bold text-white mb-6">
        <span>Total:</span>
        <span id="sidebar-total">$0</span>
      </div>
      <a
        href="/checkout"
        class="block w-full py-4 bg-angus-red hover:bg-red-700 text-white text-center font-bold rounded-xl transition-all shadow-lg"
      >
        Continuar al Pago
      </a>
    </div>
  </div>
</aside>

<script is:inline>
  const openBtn = document.getElementById("open-cart");
  const closeBtn = document.getElementById("close-cart");
  const sidebar = document.getElementById("cart-sidebar");
  const overlay = document.getElementById("cart-overlay");

  // Función para abrir
  window.openCartSidebar = function () {
    sidebar.classList.remove("translate-x-full");
    overlay.classList.remove("hidden");
    renderCart();
  };

  window.toggleCart = () => {
    sidebar.classList.toggle("translate-x-full");
    overlay.classList.toggle("hidden");
    if (!sidebar.classList.contains("translate-x-full")) renderCart();
  };

  openBtn.addEventListener("click", toggleCart);
  closeBtn.addEventListener("click", toggleCart);
  overlay.addEventListener("click", toggleCart);

  // --- LÓGICA DEL CARRITO ---

  window.renderCart = function () {
    const cart = JSON.parse(localStorage.getItem("cart") || "[]");
    const cartList = document.getElementById("sidebar-cart-items");
    const totalSpan = document.getElementById("sidebar-total");
    const countSpan = document.getElementById("cart-count");

    // Actualizar contador del icono flotante
    const totalQty = cart.reduce((acc, item) => acc + item.qty, 0);
    if (countSpan) countSpan.innerText = totalQty;

    if (cart.length === 0) {
      cartList.innerHTML =
        '<p class="text-gray-500 text-center mt-10">Tu carrito está vacío</p>';
      totalSpan.innerText = "$0";
      return;
    }

    let total = 0;
    cartList.innerHTML = cart
      .map((item) => {
        const subtotal = item.price * item.qty;
        total += subtotal;

        // Verificamos si llegamos al tope de stock para deshabilitar el botón +
        const isMaxStock = item.stock !== -1 && item.qty >= item.stock;

        return `
        <div class="bg-white/5 p-4 rounded-xl border border-white/5 flex flex-col gap-3">
          <div class="flex justify-between items-start">
            <div>
              <h3 class="text-white font-bold text-sm">${item.name}</h3>
              ${item.stock !== -1 ? `<p class="text-[10px] text-zinc-500">Stock disponible: ${item.stock}</p>` : ""}
            </div>
            <button onclick="removeFromCart('${item.id}')" class="text-zinc-500 hover:text-red-500 transition-colors">
               <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"/></svg>
            </button>
          </div>
          <div class="flex justify-between items-center">
            <p class="text-angus-orange font-bold font-mono text-sm">$${subtotal.toLocaleString("es-CL")}</p>
            <div class="flex items-center bg-black rounded-lg border border-white/10 overflow-hidden">
              <button onclick="updateQty('${item.id}', -1)" class="px-3 py-1 text-white hover:bg-zinc-800 font-bold">-</button>
              <span class="px-3 py-1 text-white text-xs font-bold min-w-[30px] text-center">${item.qty}</span>
              <button 
                onclick="updateQty('${item.id}', 1)" 
                ${isMaxStock ? "disabled" : ""}
                class="px-3 py-1 text-white hover:bg-zinc-800 font-bold disabled:opacity-20 disabled:cursor-not-allowed"
              >
                +
              </button>
            </div>
          </div>
        </div>`;
      })
      .join("");

    totalSpan.innerText = `$${total.toLocaleString("es-CL")}`;
  };

  window.updateQty = function (id, change) {
    let cart = JSON.parse(localStorage.getItem("cart") || "[]");
    // Buscamos comparando como String para evitar errores de tipo
    const item = cart.find((i) => String(i.id) === String(id));

    if (item) {
      if (change > 0) {
        // Verificar stock antes de sumar
        if (item.stock !== -1 && item.qty >= item.stock) return;
        item.qty += 1;
      } else {
        item.qty -= 1;
      }

      if (item.qty <= 0) {
        cart = cart.filter((i) => String(i.id) !== String(id));
      } else {
        item.totalPrice = item.qty * item.price;
      }

      localStorage.setItem("cart", JSON.stringify(cart));
      renderCart();
      window.dispatchEvent(new Event("cart-updated"));
    }
  };

  window.removeFromCart = function (id) {
    let cart = JSON.parse(localStorage.getItem("cart") || "[]");
    cart = cart.filter((i) => String(i.id) !== String(id));
    localStorage.setItem("cart", JSON.stringify(cart));
    renderCart();
    window.dispatchEvent(new Event("cart-updated"));
  };

  // Escuchar eventos y carga inicial
  window.addEventListener("cart-updated", renderCart);
  document.addEventListener("DOMContentLoaded", renderCart);
</script>
