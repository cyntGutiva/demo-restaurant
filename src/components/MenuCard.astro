---
// Pasamos las credenciales al cliente de forma segura para el fetch
const publicUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const publicAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---

<section id="menu" class="py-24 bg-angus-dark relative">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-heading font-bold text-white mb-4">
        Nuestra Carta
      </h2>
    </div>

    <div id="menu-dinamico" class="space-y-20">
      <div class="text-center py-20 text-gray-500">Cargando delicias...</div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ publicUrl, publicAnonKey }}>
  const formatter = new Intl.NumberFormat("es-CL", {
    style: "currency",
    currency: "CLP",
    minimumFractionDigits: 0,
  });

  async function cargarMenu() {
    const container = document.getElementById("menu-dinamico");

    try {
      const queryParams = "select=id,nombre,orden,productos(*)&order=orden.asc";

      const response = await fetch(
        `${publicUrl}/rest/v1/categorias?${queryParams}`,
        {
          headers: {
            apikey: publicAnonKey,
            Authorization: `Bearer ${publicAnonKey}`,
          },
        },
      );

      const categorias = await response.json();
      container.innerHTML = "";

      categorias.forEach((cat) => {
        // 1. Filtrar solo los que están marcados como disponibles en el admin
        const productosVisibles = cat.productos.filter(
          (p) => p.disponible === true,
        );

        if (productosVisibles.length === 0) return;

        // 2. ORDENAMIENTO PERSONALIZADO:
        // Prioridad: Stock > Destacado > Orden manual
        const productosOrdenados = productosVisibles.sort((a, b) => {
          const stockA = a.stock > 0 ? 1 : 0;
          const stockB = b.stock > 0 ? 1 : 0;

          // Primero por stock (los que tienen stock 1, agotados 0)
          if (stockA !== stockB) return stockB - stockA;

          // Luego por destacado (true = 1, false = 0)
          if (a.destacado !== b.destacado) return b.destacado - a.destacado;

          // Finalmente por el orden manual asignado
          return a.orden - b.orden;
        });

        let cardsHtml = productosOrdenados
          .map((item) => {
            const esAgotado = item.stock <= 0;

            const badgeDestacado = item.destacado
              ? `<div class="absolute top-4 left-4 bg-yellow-500 text-slate-950 px-3 py-1 rounded-full text-xs font-black uppercase tracking-tighter shadow-lg z-20 ${esAgotado ? "opacity-50 grayscale" : "animate-pulse"}">
                 🔥 Popular
                </div>`
              : "";

            const cardStyleClasses = `
              menu-card bg-angus-black rounded-2xl overflow-hidden border flex flex-col group transition-all duration-300 relative
              ${item.destacado ? "border-yellow-500/30" : "border-white/5"}
              ${esAgotado ? "brightness-[0.35] grayscale-[0.7] pointer-events-none" : "hover:border-white/10"}
            `;

            return `
          <div class="${cardStyleClasses}">
            ${badgeDestacado}
            <div class="h-48 overflow-hidden relative bg-gray-800">
              ${
                item.image_url
                  ? `<img src="${item.image_url}" alt="${item.nombre}" class="w-full h-full object-cover ${!esAgotado ? "group-hover:scale-110" : ""} transition-transform" loading="lazy" />`
                  : `<div class="w-full h-full flex items-center justify-center bg-zinc-900 text-zinc-700 text-xs italic">Sin imagen</div>`
              }
              <div class="absolute top-4 right-4 bg-angus-red text-white px-3 py-1 rounded-full font-bold shadow-lg z-10 ${esAgotado ? "opacity-50" : ""}">
                ${formatter.format(item.precio)}
              </div>
            </div>

            <div class="p-6 flex flex-col flex-1">
              <h3 class="text-xl font-bold text-white mb-2">${item.nombre}</h3>
              <p class="text-gray-400 text-sm mb-4 line-clamp-2">${item.descripcion || ""}</p>
              
              <button
                class="add-to-cart-btn w-full py-2 rounded-lg border ${item.destacado ? "border-yellow-500/50 text-yellow-500" : "border-white/10 text-white"} transition-all mt-auto disabled:opacity-50 font-semibold"
                data-id="${item.id}"
                data-nombre="${item.nombre}"
                data-precio="${item.precio}"
                data-stock="${item.stock}"
                ${esAgotado ? "disabled" : ""}
              >
                ${esAgotado ? "Agotado" : "Agregar al pedido"}
              </button>
            </div>
          </div>
        `;
          })
          .join("");

        container.innerHTML += `
          <div class="category-block">
            <div class="flex items-center gap-4 mb-10">
              <h3 class="text-2xl font-bold text-angus-orange uppercase tracking-wider">${cat.nombre}</h3>
              <div class="h-px bg-white/10 flex-1"></div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
              ${cardsHtml}
            </div>
          </div>
        `;
      });

      if (window.actualizarBotonesStock) {
        window.actualizarBotonesStock();
      }
    } catch (err) {
      console.error("Error cargando el menú:", err);
      container.innerHTML =
        '<p class="text-center text-red-500 py-10">Error al conectar con la carta dinámica.</p>';
    }
  }

  document.addEventListener("DOMContentLoaded", cargarMenu);
</script>
