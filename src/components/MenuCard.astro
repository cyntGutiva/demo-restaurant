---
// Importas tu cliente actual
import { supabase } from "../lib/supabase";

// Pasamos las credenciales al cliente de forma segura para el fetch
const publicUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const publicAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---

<section id="menu" class="py-24 bg-angus-dark relative">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-heading font-bold text-white mb-4">
        Nuestra Carta
      </h2>
    </div>

    <div id="menu-dinamico" class="space-y-20">
      <div class="text-center py-20 text-gray-500">Cargando delicias...</div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ publicUrl, publicAnonKey }}>
  // Función para formatear dinero en Chile
  const formatter = new Intl.NumberFormat("es-CL", {
    style: "currency",
    currency: "CLP",
    minimumFractionDigits: 0,
  });

  async function cargarMenu() {
    const container = document.getElementById("menu-dinamico");

    try {
      // Usamos fetch directo para no cargar toda la librería de Supabase en el cliente
      // pero usamos las credenciales de tu archivo de config
      const response = await fetch(
        `${publicUrl}/rest/v1/categorias?select=id,nombre,orden,productos(*)&order=orden.asc&productos.order=orden.asc`,
        {
          headers: {
            apikey: publicAnonKey,
            Authorization: `Bearer ${publicAnonKey}`,
          },
        },
      );

      const categorias = await response.json();
      container.innerHTML = "";

      categorias.forEach((cat) => {
        const productosValidos = cat.productos.filter((p) => p.disponible);
        if (productosValidos.length === 0) return;

        let cardsHtml = productosValidos
          .map(
            (item) => `
          <div class="menu-card bg-angus-black rounded-2xl overflow-hidden border border-white/5 flex flex-col group transition-all duration-300 hover:border-white/10">
            <div class="h-48 overflow-hidden relative bg-gray-800">
              ${
                item.image_url
                  ? `<img src="${item.image_url}" alt="${item.nombre}" class="w-full h-full object-cover group-hover:scale-110 transition-transform" loading="lazy" />`
                  : `<div class="w-full h-full flex items-center justify-center bg-zinc-900 text-zinc-700 text-xs">NO IMAGE</div>`
              }
              <div class="absolute top-4 right-4 bg-angus-red text-white px-3 py-1 rounded-full font-bold shadow-lg">
                ${formatter.format(item.precio)}
              </div>
            </div>

            <div class="p-6 flex flex-col flex-1">
              <h3 class="text-xl font-bold text-white mb-2">${item.nombre}</h3>
              <p class="text-gray-400 text-sm mb-4 line-clamp-2">${item.descripcion || ""}</p>
              
              <button
                class="add-to-cart-btn w-full py-2 rounded-lg border border-white/10 text-white hover:bg-white hover:text-angus-black transition-all mt-auto disabled:opacity-50 font-semibold"
                data-id="${item.id}"
                data-nombre="${item.nombre}"
                data-precio="${item.precio}"
                data-stock="${item.stock}"
              >
                ${item.stock <= 0 ? "Agotado" : "Agregar al pedido"}
              </button>
            </div>
          </div>
        `,
          )
          .join("");

        container.innerHTML += `
          <div class="category-block">
            <div class="flex items-center gap-4 mb-10">
              <h3 class="text-2xl font-bold text-angus-orange uppercase tracking-wider">${cat.nombre}</h3>
              <div class="h-px bg-white/10 flex-1"></div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
              ${cardsHtml}
            </div>
          </div>
        `;
      });

      // ¡IMPORTANTE! Re-ejecutar la lógica de stock del carrito
      if (window.actualizarBotonesStock) {
        window.actualizarBotonesStock();
      }
    } catch (err) {
      console.error("Error cargando el menú:", err);
      container.innerHTML =
        '<p class="text-center text-red-500">Error al conectar con la base de datos.</p>';
    }
  }

  // Iniciamos la carga
  document.addEventListener("DOMContentLoaded", cargarMenu);
</script>
