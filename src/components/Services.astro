---
import { supabase } from "../lib/supabase";

type Servicio = {
  id: number;
  icono: string;
  titulo: string;
  descripcion: string;
  activa: boolean;
};

const { data: servicios } = await supabase
  .from("servicios")
  .select("*")
  .order("id");
---

<section id="services" class="py-24 bg-angus-dark border-y border-white/5">
  <div class="max-w-7xl mx-auto px-6 text-center">
    <h2 class="text-4xl font-heading font-bold text-white mb-16">
      Servicios para ti
    </h2>
    <div class="flex flex-wrap justify-center gap-8">
      {
        (servicios || [])
          .filter((s: Servicio) => s.activa)
          .map((s: Servicio) => (
            <div class="service-card w-full sm:w-64 p-8 bg-angus-black rounded-2xl border border-white/5 hover:bg-gradient-to-b hover:from-angus-black hover:to-angus-red/10 transition-all group">
              <div class="w-14 h-14 bg-angus-red/20 rounded-xl flex items-center justify-center mb-6 mx-auto group-hover:bg-angus-red/40 transition-colors">
                <i data-lucide={s.icono} class="text-angus-red w-8 h-8" />
              </div>
              <h4 class="text-xl font-bold text-white mb-3">{s.titulo}</h4>
              <p class="text-gray-400 text-sm leading-relaxed">
                {s.descripcion}
              </p>
            </div>
          ))
      }
    </div>
  </div>
</section>
